{
  "name": "remember-me",
  "version": "0.1.0",
  "private": true,
  "description": "User-scoped persistent assistant memory on node:sqlite, with explicit writes, correction, deletion and backend-enforced access.",
  "type": "module",
  "engines": { "node": ">=22.13" },
  "scripts": {
    "demo": "node --disable-warning=ExperimentalWarning --import tsx src/cli/demo.ts",
    "serve": "node --disable-warning=ExperimentalWarning --import tsx src/cli/serve.ts",
    "live": "node --disable-warning=ExperimentalWarning --import tsx src/cli/live.ts",
    "test": "node --disable-warning=ExperimentalWarning --import tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
